{
  "spec": {
    "version": "1",
    "application": {
      "name": "php-wordpress"
    },
    "services": [
      {
        "id": "web",
        "type": "http",
        "runtime": "php",
        "port": 8080,
        "healthPath": "/"
      }
    ],
    "data": [
      {
        "id": "database",
        "type": "relational",
        "engine": "mysql"
      }
    ],
    "storage": [
      {
        "id": "uploads",
        "type": "file-system"
      }
    ],
    "extensions": {
      "x-php": {
        "kind": "wordpress"
      }
    }
  },
  "questions": [],
  "capabilities": ["file-system-write", "http-service", "relational-data"]
}
