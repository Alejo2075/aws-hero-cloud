{
  "spec": {
    "version": "1",
    "application": {
      "name": "orders-api"
    },
    "services": [
      {
        "id": "api",
        "type": "http",
        "runtime": "nodejs",
        "build": {
          "command": "npm run build"
        },
        "start": {
          "command": "npm start"
        },
        "port": 4000,
        "healthPath": "/health"
      }
    ],
    "data": [
      {
        "id": "kv",
        "type": "key-value",
        "key": {
          "partition": {
            "name": "id",
            "type": "string"
          }
        }
      }
    ],
    "environment": ["API_KEY", "TABLE_NAME"],
    "extensions": {
      "x-node": {
        "packageManager": "npm"
      }
    }
  },
  "questions": ["data.keys-confirm"],
  "capabilities": ["environment-variables", "http-service", "key-value-data", "node-runtime"]
}
