{
  "spec": {
    "version": "1",
    "application": {
      "name": "python-flask"
    },
    "services": [
      {
        "id": "web",
        "type": "http",
        "runtime": "python",
        "start": {
          "command": "gunicorn --bind 0.0.0.0:$PORT app:app"
        },
        "port": 8000,
        "healthPath": "/health"
      }
    ]
  },
  "questions": [],
  "capabilities": ["http-service"]
}
