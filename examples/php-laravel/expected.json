{
  "spec": {
    "version": "1",
    "application": {
      "name": "php-laravel"
    },
    "services": [
      {
        "id": "web",
        "type": "http",
        "runtime": "php",
        "port": 8080,
        "healthPath": "/"
      }
    ],
    "data": [
      {
        "id": "database",
        "type": "relational",
        "engine": "postgres"
      }
    ],
    "extensions": {
      "x-php": {
        "kind": "laravel"
      }
    }
  },
  "questions": [],
  "capabilities": ["http-service", "relational-data"]
}
