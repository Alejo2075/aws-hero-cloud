{
  "name": "aws-hero-cloud",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Open-source application-to-AWS deployment engine.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @hero-cloud/web dev",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,astro,css,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,astro,css,json,md,yml}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alejo2075/aws-hero-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejo2075/aws-hero-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/Alejo2075/aws-hero-cloud/issues"
  },
  "keywords": [
    "aws",
    "deployment",
    "cloud",
    "cloudformation",
    "open-source",
    "sdk",
    "cli",
    "mcp",
    "local-first",
    "byo-ai"
  ],
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "packageExtensions": {
      "@astrojs/astro2tsx": {
        "dependencies": {
          "@napi-rs/wasm-runtime": "*",
          "@emnapi/core": "*",
          "@emnapi/runtime": "*"
        }
      }
    }
  }
}
