{
  "name": "aws-hero-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source application-to-AWS deployment engine.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @hero-cloud/web dev",
    "format": "prettier --write \"**/*.{js,mjs,ts,astro,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,astro,css,json,md}\"",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.9.3"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alejo2075/aws-hero-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejo2075/aws-hero-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/Alejo2075/aws-hero-cloud/issues"
  },
  "keywords": [
    "aws",
    "deployment",
    "cloud",
    "cloudformation",
    "open-source",
    "sdk",
    "cli",
    "mcp",
    "local-first",
    "byo-ai"
  ]
}
