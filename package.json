{
  "name": "aws-hero-cloud",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Open-source application-to-AWS deployment engine.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @hero-cloud/web dev",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,astro,css,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,astro,css,json,md,yml}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:packages": "tsc -b tsconfig.build.json",
    "release:prepare": "node scripts/prepare-release.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm --filter @hero-cloud/cli build && changeset publish",
    "api:check": "pnpm build:packages && api-extractor run --config packages/core/api-extractor.json && api-extractor run --config packages/sdk/api-extractor.json",
    "api:update": "pnpm build:packages && api-extractor run --local --config packages/core/api-extractor.json && api-extractor run --local --config packages/sdk/api-extractor.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@hero-cloud/analyzer": "workspace:*",
    "@hero-cloud/cli": "workspace:*",
    "@hero-cloud/core": "workspace:*",
    "@hero-cloud/mcp": "workspace:*",
    "@hero-cloud/server": "workspace:*",
    "@hero-cloud/planner": "workspace:*",
    "@hero-cloud/plugin-node": "workspace:*",
    "@hero-cloud/plugin-sdk": "workspace:*",
    "@hero-cloud/presentation": "workspace:*",
    "@hero-cloud/provider-ai": "workspace:*",
    "@hero-cloud/provider-aws": "workspace:*",
    "@hero-cloud/sdk": "workspace:*",
    "@hero-cloud/shared": "workspace:*",
    "@microsoft/api-extractor": "^7.59.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alejo2075/aws-hero-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejo2075/aws-hero-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/Alejo2075/aws-hero-cloud/issues"
  },
  "keywords": [
    "aws",
    "deployment",
    "cloud",
    "cloudformation",
    "open-source",
    "sdk",
    "cli",
    "mcp",
    "local-first",
    "byo-ai"
  ],
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "packageExtensions": {
      "@astrojs/astro2tsx": {
        "dependencies": {
          "@napi-rs/wasm-runtime": "*",
          "@emnapi/core": "*",
          "@emnapi/runtime": "*"
        }
      }
    }
  }
}
