{
  "name": "@hero-cloud/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejo2075/aws-hero-cloud.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@hero-cloud/analyzer": "workspace:*",
    "@hero-cloud/core": "workspace:*",
    "@hero-cloud/planner": "workspace:*",
    "@hero-cloud/plugin-node": "workspace:*",
    "@hero-cloud/plugin-sdk": "workspace:*",
    "@hero-cloud/provider-aws": "workspace:*",
    "@hero-cloud/shared": "workspace:*",
    "@hero-cloud/sources": "workspace:*",
    "@hero-cloud/specification": "workspace:*"
  },
  "devDependencies": {
    "fflate": "^0.8.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "dist/index.d.ts"
  }
}
