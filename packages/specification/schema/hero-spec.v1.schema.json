{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "application": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,62}$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._+-]{0,40}$"
        },
        "build": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "workingDirectory": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._@/+-]{1,200}$"
            },
            "output": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._@/+-]{1,200}$"
            }
          },
          "required": [
            "command",
            "output"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "framework"
      ],
      "additionalProperties": false
    },
    "services": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "http",
              "worker",
              "scheduled",
              "process"
            ]
          },
          "runtime": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._+-]{0,40}$"
          },
          "build": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "workingDirectory": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._@/+-]{1,200}$"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "start": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "workingDirectory": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._@/+-]{1,200}$"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "healthPath": {
            "type": "string",
            "pattern": "^\\/(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._~!$&'()*+,;=:@/%-]{0,199}$"
          }
        },
        "required": [
          "id",
          "type",
          "runtime"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "key-value",
              "document",
              "relational",
              "cache",
              "search"
            ]
          },
          "engine": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._+-]{0,40}$"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "storage": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "object",
              "file-system"
            ]
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    },
    "environment": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^x-[a-z0-9-]{1,60}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "version",
    "application"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
