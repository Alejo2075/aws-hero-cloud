{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../core/tsconfig.build.json"
    },
    {
      "path": "../../shared/tsconfig.build.json"
    },
    {
      "path": "../../specification/tsconfig.build.json"
    }
  ]
}
