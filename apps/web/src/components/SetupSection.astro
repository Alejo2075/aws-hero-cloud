---
const resources = [
  {
    number: '01',
    title: 'Run the CLI',
    summary: 'Analyze, plan, approve.',
    text: 'The command line is the primary interface. Start with your application and move forward one explicit step at a time.',
    commands: [
      'hero-cloud init',
      'hero-cloud analyze ./my-app',
      'hero-cloud plan',
      'hero-cloud deploy',
    ],
    note: 'The public CLI is being prepared for its first release.',
  },
  {
    number: '02',
    title: 'Connect AWS',
    summary: 'Use credentials you control.',
    text: 'Authenticate with a standard AWS profile or SSO session. Credentials stay in your environment; this site never receives them.',
    commands: [
      'aws configure sso --profile hero',
      'aws sso login --profile hero',
      'export AWS_PROFILE=hero',
    ],
    note: 'Roles, CloudShell, and execution-environment credentials are also supported.',
  },
  {
    number: '03',
    title: 'Connect AI',
    summary: 'Optional and provider-neutral.',
    text: 'Choose an AI provider only when it adds value. Deterministic analysis remains available without a model.',
    commands: ['export HERO_AI_PROVIDER=openai', 'export OPENAI_API_KEY=<your-local-key>'],
    note: 'Keep provider keys local and out of source control.',
  },
] as const;
---

<section class="setup-section" id="setup" aria-labelledby="setup-title">
  <div class="page-shell setup-section__layout">
    <header class="setup-section__intro">
      <p class="eyebrow"><span>03</span> Use it</p>
      <h2 id="setup-title">Three pieces. One local workflow.</h2>
      <p>
        Open each step for the commands. Copying happens in your browser and secrets stay local.
      </p>
      <span class="setup-section__stamp">BYO AWS / BYO AI</span>
    </header>

    <div class="setup-list">
      {
        resources.map((resource, index) => (
          <details open={index === 0}>
            <summary data-sfx="move">
              <span class="setup-list__number">{resource.number}</span>
              <span class="setup-list__title">{resource.title}</span>
              <span class="setup-list__summary">{resource.summary}</span>
              <span class="setup-list__toggle" aria-hidden="true">
                OPEN
              </span>
            </summary>
            <div class="setup-list__body">
              <p>{resource.text}</p>
              <div class="command-list" aria-label={`${resource.title} commands`}>
                {resource.commands.map((command) => (
                  <div class="command-row">
                    <code>
                      <span aria-hidden="true">$</span> {command}
                    </code>
                    <button type="button" data-copy={command} data-sfx="confirm">
                      COPY
                    </button>
                  </div>
                ))}
                <p class="command-list__feedback" role="status" aria-live="polite" />
              </div>
              <p class="setup-list__note">
                <strong>NOTE /</strong> {resource.note}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
