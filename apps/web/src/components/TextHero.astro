---
import TextLink from './TextLink.astro';

interface Props {
  repository: string;
}

const { repository } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <header class="site-header page-shell">
    <a class="nameplate" href="#top" aria-label="Hero Cloud home">
      <span>HERO</span>
      <span>CLOUD</span>
    </a>
    <a class="source-link" href={repository} target="_blank" rel="noreferrer" data-sfx="move">
      Source code <span aria-hidden="true">↗</span>
    </a>
  </header>

  <div class="hero__body page-shell">
    <div class="hero__copy">
      <p class="eyebrow"><span>01</span> Open-source deployment engine</p>
      <h1 id="hero-title">
        <span>Ship with</span>
        <span>intent.</span>
      </h1>
      <p class="hero__lede">
        Understand your app, review the infrastructure, then deploy to your own AWS account.
      </p>
      <div class="hero__actions">
        <TextLink href="#setup" label="Start with the CLI" />
        <TextLink href="#system" label="See how it works" tone="line" />
      </div>
    </div>

    <div class="hero__signal" aria-hidden="true">
      <span class="hero__signal-label">SYSTEM READY</span>
      <div class="hero__signal-word">PLAN</div>
      <div class="hero__signal-bars"><i></i><i></i><i></i><i></i><i></i></div>
      <span class="hero__signal-code">H/C · 001</span>
    </div>
  </div>

  <ol class="hero__rail page-shell" aria-label="Hero Cloud workflow">
    <li><span>01</span> Analyze</li>
    <li><span>02</span> Plan</li>
    <li><span>03</span> Approve</li>
    <li><span>04</span> Deploy</li>
  </ol>
</section>
