---
import '../styles/global.css';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/pixelact-ui/alert';
import { Badge } from '@/components/ui/pixelact-ui/badge';
import { Button } from '@/components/ui/pixelact-ui/button';
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/ui/pixelact-ui/card';
import { Kbd } from '@/components/ui/pixelact-ui/kbd';
import { project } from '../data/project';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c1c1c" />
    <meta
      name="description"
      content="Hero Cloud analiza aplicaciones, prepara planes de despliegue revisables y despliega en tu cuenta de AWS después de tu aprobación."
    />
    <title>Hero Cloud — Planifica antes de desplegar</title>
  </head>
  <body>
    <main class="min-h-screen bg-background px-5 py-8 text-foreground md:px-10 md:py-12">
      <div class="mx-auto grid max-w-6xl gap-16 md:gap-24">
        <header aria-label="Navegación principal">
          <Card>
            <CardContent className="flex flex-wrap items-center justify-between gap-5">
              <Badge variant="secondary">Hero Cloud</Badge>
              <nav class="flex flex-wrap items-center gap-2" aria-label="Secciones">
                <Button variant="link" size="sm" asChild>
                  <a href="#explicacion">Proyecto</a>
                </Button>
                <Button variant="link" size="sm" asChild>
                  <a href="#guia">Guía</a>
                </Button>
                <Button variant="link" size="sm" asChild>
                  <a href="#preguntas">Preguntas</a>
                </Button>
              </nav>
            </CardContent>
          </Card>
        </header>

        <section id="hero" aria-labelledby="hero-title">
          <Card className="min-h-[32rem] justify-between">
            <CardHeader className="gap-8 py-10 md:py-16">
              <CardAction>
                <Badge variant="outline">Open source</Badge>
              </CardAction>
              <CardTitle id="hero-title" className="max-w-4xl text-4xl md:text-6xl">
                De tu aplicación a AWS, con un plan antes de tocar nada.
              </CardTitle>
              <CardDescription className="max-w-3xl text-base leading-8 md:text-lg">
                Dale a Hero Cloud cualquier aplicación, nueva o antigua. Entiende lo que necesita,
                prepara un plan que puedes leer, lo despliega en tu cuenta de AWS cuando lo apruebas
                y comprueba que funciona.
              </CardDescription>
            </CardHeader>
            <CardFooter className="flex flex-wrap gap-4 py-8">
              <Button variant="success" size="lg" asChild>
                <a href={project.repository} target="_blank" rel="noreferrer noopener">
                  Ver el código
                </a>
              </Button>
              <Button variant="warning" size="lg" asChild>
                <a href="#explicacion">Cómo funciona</a>
              </Button>
            </CardFooter>
          </Card>
        </section>

        <section id="explicacion" class="grid gap-8" aria-labelledby="explicacion-title">
          <Card>
            <CardHeader>
              <CardAction>
                <Badge>El proyecto</Badge>
              </CardAction>
              <CardTitle id="explicacion-title" className="text-3xl md:text-4xl">
                Un motor abierto entre tu aplicación y AWS
              </CardTitle>
              <CardDescription className="max-w-3xl text-base leading-7">
                No es un hosting SaaS ni necesita una cuenta de Hero. Tú conservas tus credenciales,
                tu proveedor de IA y tu infraestructura.
              </CardDescription>
            </CardHeader>
          </Card>

          <div class="grid gap-8 md:grid-cols-3">
            <Card>
              <CardHeader>
                <Badge variant="secondary">01</Badge>
                <CardTitle>Analiza</CardTitle>
                <CardDescription>
                  Lee un directorio local, repositorio Git o ZIP y extrae requisitos de la
                  aplicación mediante análisis determinista e IA opcional.
                </CardDescription>
              </CardHeader>
            </Card>

            <Card>
              <CardHeader>
                <Badge variant="secondary">02</Badge>
                <CardTitle>Planifica</CardTitle>
                <CardDescription>
                  Convierte los requisitos en una Hero Spec neutral y después prepara un plan AWS
                  explícito que puedes revisar antes de aplicar cambios.
                </CardDescription>
              </CardHeader>
            </Card>

            <Card>
              <CardHeader>
                <Badge variant="secondary">03</Badge>
                <CardTitle>Despliega</CardTitle>
                <CardDescription>
                  Tras tu aprobación, ejecuta el plan mediante el proveedor AWS usando tus propias
                  credenciales y tu propia cuenta.
                </CardDescription>
              </CardHeader>
            </Card>
          </div>

          <Alert>
            <AlertTitle>Estado: pre-alfa</AlertTitle>
            <AlertDescription>
              Los contratos y la arquitectura ya están definidos, pero el motor todavía se está
              construyendo. Hoy no se puede desplegar nada con Hero Cloud.
            </AlertDescription>
          </Alert>

          <Alert>
            <AlertTitle>La aprobación es la frontera</AlertTitle>
            <AlertDescription>
              Ninguna creación, modificación o eliminación de infraestructura debe ejecutarse sin un
              plan explícito y revisable.
            </AlertDescription>
          </Alert>
        </section>

        <section id="guia" class="grid gap-8" aria-labelledby="guia-title">
          <Card>
            <CardHeader>
              <CardAction>
                <Badge variant="outline">Próximamente</Badge>
              </CardAction>
              <CardTitle id="guia-title" className="text-3xl md:text-4xl">
                Del código al despliegue
              </CardTitle>
              <CardDescription className="max-w-3xl text-base leading-7">
                El mismo motor alimentará la CLI, Hero Studio, el SDK y tu asistente de IA. Así será
                el recorrido desde la terminal; la CLI todavía está en desarrollo.
              </CardDescription>
            </CardHeader>
          </Card>

          <div class="grid gap-8 md:grid-cols-2">
            <Card>
              <CardHeader>
                <Badge>01</Badge>
                <CardTitle>Elige tu aplicación</CardTitle>
                <CardDescription>
                  Una carpeta local, un repositorio Git o un archivo ZIP, de cualquier antigüedad.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <Kbd>hero-cloud analyze ./mi-app</Kbd>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <Badge>02</Badge>
                <CardTitle>Entiende lo que necesita</CardTitle>
                <CardDescription>
                  Hero detecta el framework y las capacidades necesarias sin ejecutar el código
                  recibido.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <Kbd>hero-cloud analyze ./mi-app --level simple</Kbd>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <Badge>03</Badge>
                <CardTitle>Revisa el plan</CardTitle>
                <CardDescription>
                  Inspecciona los recursos y cambios propuestos antes de autorizar cualquier
                  mutación en AWS.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <Kbd>hero-cloud plan ./mi-app</Kbd>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <Badge>04</Badge>
                <CardTitle>Aprueba, despliega y comprueba</CardTitle>
                <CardDescription>
                  Solo después de que apruebas el plan exacto, Hero lo ejecuta en tu cuenta de AWS y
                  comprueba que el sistema funciona.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <Kbd>hero-cloud deploy ./mi-app</Kbd>
              </CardContent>
            </Card>
          </div>
        </section>

        <section id="preguntas" class="grid gap-8" aria-labelledby="preguntas-title">
          <Card>
            <CardHeader>
              <CardAction>
                <Badge variant="destructive">FAQ</Badge>
              </CardAction>
              <CardTitle id="preguntas-title" className="text-3xl md:text-4xl">
                Preguntas frecuentes
              </CardTitle>
              <CardDescription className="text-base">
                Lo esencial antes de conectar una aplicación.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div class="grid gap-8 md:grid-cols-2">
                <Card>
                  <CardHeader>
                    <CardTitle>¿Necesito una cuenta de Hero?</CardTitle>
                    <CardDescription>
                      No. Hero Cloud puede funcionar sin cuentas, organizaciones, suscripciones ni
                      una base de datos central de clientes.
                    </CardDescription>
                  </CardHeader>
                </Card>

                <Card>
                  <CardHeader>
                    <CardTitle>¿Dónde se despliega mi aplicación?</CardTitle>
                    <CardDescription>
                      En tu propia cuenta de AWS, utilizando tus credenciales o un entorno de
                      ejecución que tú controles.
                    </CardDescription>
                  </CardHeader>
                </Card>

                <Card>
                  <CardHeader>
                    <CardTitle>¿La IA es obligatoria?</CardTitle>
                    <CardDescription>
                      No. Hero prioriza el análisis determinista y utiliza IA opcionalmente para
                      resolver ambigüedades.
                    </CardDescription>
                  </CardHeader>
                </Card>

                <Card>
                  <CardHeader>
                    <CardTitle>¿Puede desplegar sin mi aprobación?</CardTitle>
                    <CardDescription>
                      No. La aprobación separa la planificación de cualquier cambio real en AWS.
                    </CardDescription>
                  </CardHeader>
                </Card>

                <Card className="md:col-span-2">
                  <CardHeader>
                    <CardTitle>¿Qué aplicaciones cubre?</CardTitle>
                    <CardDescription>
                      Empezamos con JavaScript y TypeScript (React, Vite, Node.js). El objetivo es
                      cualquier aplicación, incluidas las antiguas, con carpetas locales,
                      repositorios Git y archivos ZIP.
                    </CardDescription>
                  </CardHeader>
                </Card>
              </div>
            </CardContent>
          </Card>
        </section>

        <footer aria-label="Pie de página">
          <Card>
            <CardHeader>
              <CardAction>
                <Badge variant="secondary">Open source</Badge>
              </CardAction>
              <CardTitle>Hero Cloud</CardTitle>
              <CardDescription> Tu aplicación. Tu IA. Tu AWS. Tu infraestructura. </CardDescription>
            </CardHeader>
            <CardFooter className="flex flex-wrap justify-between gap-4">
              <Button variant="success" asChild>
                <a href="#hero">Volver arriba</a>
              </Button>
              <Button variant="link" asChild>
                <a href={project.issues} target="_blank" rel="noreferrer noopener">
                  Reportar un problema
                </a>
              </Button>
            </CardFooter>
          </Card>
        </footer>
      </div>
    </main>
  </body>
</html>
