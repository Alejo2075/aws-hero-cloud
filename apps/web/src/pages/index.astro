---
import App from '../components/App';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#164bea" />
    <title>Hero Cloud — Put your app online.</title>
    <meta
      name="description"
      content="Hero helps you put your app on Amazon’s cloud. See the plan and estimated cost, then decide. Free, open-source software that runs on your computer."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Hero Cloud — Put your app online." />
    <meta
      property="og:description"
      content="Open source. Local first. Review the plan, approve the changes, and deploy to your own AWS account."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/press-start-2p.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body><App client:load /></body>
</html>
