{
  "name": "@hero-cloud/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejo2075/aws-hero-cloud.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "hero-cloud": "./dist/hero-cloud.js"
  },
  "description": "The hero-cloud command line: put any application on your own AWS account.",
  "dependencies": {
    "@aws-cdk/toolkit-lib": "^1.43.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-cloudformation": "^3.1152.0",
    "@aws-sdk/client-cloudfront": "^3.1152.0",
    "@aws-sdk/client-codebuild": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@hero-cloud/local": "workspace:*",
    "@hero-cloud/mcp": "workspace:*",
    "@hero-cloud/presentation": "workspace:*",
    "@hero-cloud/sdk": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "aws",
    "deploy",
    "cdk",
    "cli"
  ]
}
